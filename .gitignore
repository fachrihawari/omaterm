node_modules/
/dist/
/build/
/.mygo/
mygo_windows_*.syso

# Local `go build -o omaterm .` output. `mygo build` writes to build/ instead.
/omaterm

# The key that signs updates. Installed apps accept only updates signed
# with it, so anyone who reads it can ship code to every user: it lives in
# a password manager and in the repository secret MYGO_UPDATER_PRIVATE_KEY,
# never here. mygo keygen writes it to ~/.config/mygo/update-keys.
mygo-update.key
mygo-update.pub
update-keys/
*.key
e2e/out/

# What scripts/threads-post.mjs published; the posts files stay.
promo/threads/**/*.state.json
