# Maintainer: OmaTerm contributors
# M11 task 11J: first-class Arch packaging for Omarchy users.
#
# Project license: MIT OR Apache-2.0 (LICENSE-MIT, LICENSE-APACHE at the
# repository root; SPDX `license` fields in every crate manifest).
# Dependency licenses are inventoried in docs/dependencies.md.

pkgname=omaterm
pkgver=0.1.0
pkgrel=1
pkgdesc='Terminal-first developer workspace with semantic CLI automation'
arch=('x86_64')
url='https://github.com/fachrihawari/omaterm'
license=('MIT' 'Apache-2.0')
depends=('gcc-libs' 'fontconfig' 'freetype2' 'libxkbcommon' 'libx11' 'libxcb' 'wayland' 'vulkan-icd-loader')
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked --bin omaterm --bin omaterm-desktop
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --locked --workspace -- --test-threads=1
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/omaterm "$pkgdir/usr/bin/omaterm"
  install -Dm755 target/release/omaterm-desktop "$pkgdir/usr/bin/omaterm-desktop"
}
